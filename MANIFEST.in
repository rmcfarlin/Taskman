include README.md pyproject.toml setup.py MANIFEST.in .gitignore
include assets/taskman.png assets/taskman.ico
recursive-include tui *.py requirements.txt
recursive-include scripts *.py *.ps1 *.cmd *.sh
recursive-include docs *.md
recursive-include .github *.yml
prune tui/logs
prune tui/__pycache__
global-exclude *.pyc *.log theme.txt
